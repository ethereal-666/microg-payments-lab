# Keep the project shareable without vendoring APKs, decompiled Google code,
# downloaded SDKs, nested upstream checkouts, signing keys or build outputs.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/ROADMAP.md
!/DEVICE_TESTS.md
!/OAUTH_SETUP.md
!/NOTICE
!/STATUS.md
!/project.json
!/tools/
!/tests/
!/patches/
!/research/
/research/*
!/research/*.json
!/native-port-probe/
/native-port-probe/*
!/native-port-probe/AndroidManifest.xml
!/native-port-probe/ProbeActivity.java
!/native-port-probe/build.py
!/verification/
/verification/*
!/verification/protocol-test-result.json
!/verification/TEST-*.xml
!/verification/native-flow-result.json
!/verification/artifacts.json
!/verification/service-integration-compile.json
!/verification/fresh-bootstrap.json
!/verification/device-native-flow.json
!/verification/device-auth-probe.json
!/verification/device-native-remote.json
!/verification/device-auth-noninteractive.json
!/verification/authorization-route-result.json
!/verification/provider-build-result.json
!/verification/provider-install-preflight.json
!/verification/native-probe-first.txt
!/verification/native-probe-context-initialized.txt
__pycache__/
*.pyc

!/verification/device-auth-delegated.json
!/verification/device-buyflow-initialize.json
!/verification/device-buyflow-internal-sandbox.json
!/verification/shared-ui-source-integrity.json
