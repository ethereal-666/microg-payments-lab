+package com.google.android.gms.wallet;
+
+import android.os.Bundle;
+
+import org.microg.safeparcel.AutoSafeParcelable;
+
+/**
+ * Wire representation of the first-party web payment request.
+ *
+ * Retains the cart, merchant context and opaque parameters for a future backend.
+ * Deserializing this object does not authorize or process a payment.
+ */
+public final class WebPaymentDataRequest extends AutoSafeParcelable {
+    @Field(2)
+    private Cart cart;
+    @Field(3)
+    private String merchantOrigin;
+    @Field(4)
+    private String walletParameters;
+    @Field(5)
+    private Bundle savedState;
+    @Field(6)
+    private byte[] encryptedParameters;
+    @Field(7)
+    private boolean useChromiumPaymentDetailsUpdate;
+
+    private WebPaymentDataRequest() {
+    }
+
+    public Cart getCart() { return cart; }
+    public String getMerchantOrigin() { return merchantOrigin; }
+    public String getWalletParameters() { return walletParameters; }
+    public Bundle getSavedState() { return savedState; }
+    public byte[] getEncryptedParameters() { return encryptedParameters; }
+    public boolean getUseChromiumPaymentDetailsUpdate() { return useChromiumPaymentDetailsUpdate; }
+
+    public static final Creator<WebPaymentDataRequest> CREATOR =
+            new AutoCreator<>(WebPaymentDataRequest.class);
+}
