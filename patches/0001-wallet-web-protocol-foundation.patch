@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.wallet.authprobe;
+
+import android.accounts.Account;
+import android.accounts.AccountManager;
+import android.app.Activity;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.os.Bundle;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import java.io.FileOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+
+/** Fixed-scope test of microG's existing, user-consented package delegation. */
+public final class DelegatedAuthActivity extends Activity {
+    private TextView output;
+    private Account selected;
+    private String accessToken;
+    private Button sandbox;
+    private Button start;
+    private static final int CHOOSE = 1, CONSENT = 2;
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        LinearLayout layout = new LinearLayout(this); layout.setOrientation(LinearLayout.VERTICAL);
+        int pad = (int)(20 * getResources().getDisplayMetrics().density); layout.setPadding(pad,pad,pad,pad);
+        output = new TextView(this);
+        output.setText("microG 框架身份委托测试\n\n使用现有 microG 的授权功能，仅请求 Sierra 支付服务 scope。不会读取主账号令牌、银行卡或发起扣款。\n\nmicroG 的身份委托授权本身可覆盖其他 scope；此测试应用的代码固定为 Sierra，没有任意 scope、包名或证书输入。必须在 microG 授权页单独同意。");
+        layout.addView(output);
+        start = new Button(this); start.setText("选择账号并请求委托授权");
+        start.setOnClickListener(view -> {
+            start.setEnabled(false);
+            startActivityForResult(AccountManager.newChooseAccountIntent(null,null,new String[]{"com.google"},null,null,null,null),CHOOSE);
+        });
+        layout.addView(start);
+        sandbox = new Button(this); sandbox.setText("验证 Google TEST 买单初始化（不扣款）"); sandbox.setEnabled(false);
+        sandbox.setOnClickListener(view -> sandbox()); layout.addView(sandbox); setContentView(layout);
+        if(getIntent().getBooleanExtra("inspect",false)) {
+            String result=BuyflowSandboxProbe.inspectCached(this);output.setText(result);
+            try(FileOutputStream f=openFileOutput("cached-inspection.json",MODE_PRIVATE)){f.write((result+"\n").getBytes(StandardCharsets.UTF_8));}catch(Exception ignored){}
+        }
+        if (state == null && getIntent().getBooleanExtra("sandbox",false)) {
+            Account[] accounts=AccountManager.get(this).getAccountsByType("com.google");
+            if(accounts.length==1) { selected=accounts[0];start.setEnabled(false);request(); }
+        }
+    }
+    @Override protected void onActivityResult(int request, int result, Intent data) {
+        super.onActivityResult(request,result,data);
+        if (result != RESULT_OK) { report(AuthProbeReport.event("cancelled"));return; }
+        if (request == CHOOSE && data != null) {
+            String name=data.getStringExtra(AccountManager.KEY_ACCOUNT_NAME);
+            if(name == null || !"com.google".equals(data.getStringExtra(AccountManager.KEY_ACCOUNT_TYPE))) {
+                report(AuthProbeReport.event("invalid_account_selection"));return;
+            }
+            selected=new Account(name,"com.google"); request();
+        } else if (request == CONSENT && selected != null) request();
+    }
+    private Bundle fixedOptions() throws Exception {
+        // Public certificate metadata supplied by the installed microG, not
+        // private signing material. Pin the upstream compatibility certificate.
+        ApplicationInfo info=getPackageManager().getApplicationInfo("com.google.android.gms",PackageManager.GET_META_DATA);
+        String hex=info.metaData.getString("fake-signature").replaceAll("\\s", "");
+        byte[] certificate=new byte[hex.length()/2];
+        for(int i=0;i<certificate.length;i++) certificate[i]=(byte)Integer.parseInt(hex.substring(i*2,i*2+2),16);
+        StringBuilder digest=new StringBuilder();
+        for(byte b:MessageDigest.getInstance("SHA-1").digest(certificate)) digest.append(String.format(java.util.Locale.ROOT,"%02x",b&255));
+        if(!digest.toString().equals("38918a453d07199354f8b19af05ec6562ced5788")) throw new SecurityException("Unexpected public certificate");
+        Bundle options=new Bundle();options.putString("overridePackage","com.google.android.gms");options.putByteArray("overrideCertificate",certificate);return options;
+    }
+    private void request() {
+        try {
+            AccountManager.get(this).getAuthToken(selected,AuthProbeReport.SCOPE,fixedOptions(),false,future -> {
+                try {
+                    Bundle result=future.getResult();
+                    Intent consent=result.getParcelable(AccountManager.KEY_INTENT);
+                    if(consent != null) {
+                        report(AuthProbeReport.event("interactive_authorization_required"));
+                        // Start only an explicit activity belonging to microG.
+                        if(consent.getComponent()==null || !"com.google.android.gms".equals(consent.getComponent().getPackageName())) throw new SecurityException();
+                        startActivityForResult(consent,CONSENT);
+                    } else {
+                        accessToken=result.getString(AccountManager.KEY_AUTHTOKEN);
+                        sandbox.setEnabled(accessToken!=null && !accessToken.isEmpty());
+                        report(AuthProbeReport.result(result));
+                        if(sandbox.isEnabled() && getIntent().getBooleanExtra("sandbox",false)) sandbox();
+                    }
+                } catch(Exception failure) { report(AuthProbeReport.failure(failure)); }
+            },null);
+        } catch(Exception failure) { report(AuthProbeReport.failure(failure)); }
+    }
+    private void sandbox() {
+        if(accessToken==null || accessToken.isEmpty()) return;
+        sandbox.setEnabled(false);
+        output.setText("正在请求 Google TEST 买单初始化…");
+        String token=accessToken;
+        new Thread(() -> {
+            String result=BuyflowSandboxProbe.run(this,token);
+            runOnUiThread(() -> {
+                output.setText(result);sandbox.setEnabled(true);
+                try(FileOutputStream file=openFileOutput("sandbox-result.json",MODE_PRIVATE)) {file.write((result+"\n").getBytes(StandardCharsets.UTF_8));}catch(Exception ignored){}
+            });
+        },"buyflow-sandbox-check").start();
+    }
+    private void report(String text) {
+        output.setText(text);start.setEnabled(true);
+        try(FileOutputStream file=openFileOutput("delegated-events.jsonl",MODE_APPEND)) {file.write((text+"\n").getBytes(StandardCharsets.UTF_8));}catch(Exception ignored){}
+    }
+}
