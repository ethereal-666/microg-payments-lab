@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.wallet.authprobe;
+
+import android.accounts.AccountManager;
+import android.accounts.AuthenticatorException;
+import android.accounts.OperationCanceledException;
+import android.os.Bundle;
+import java.io.IOException;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/** Allowlisted diagnostics. Account names, tokens and server messages stay out. */
+public final class AuthProbeReport {
+    public static final String SCOPE = "oauth2:https://www.googleapis.com/auth/sierra";
+    private AuthProbeReport() {}
+
+    public static String result(Bundle result) {
+        if (result == null) return event("empty_authenticator_response");
+        if (result.containsKey(AccountManager.KEY_ERROR_CODE)) {
+            return event("authenticator_error", result.getInt(AccountManager.KEY_ERROR_CODE));
+        }
+        String token = result.getString(AccountManager.KEY_AUTHTOKEN);
+        if (token != null && !token.isEmpty()) return event("token_acquired");
+        if (result.containsKey(AccountManager.KEY_INTENT)) return event("interactive_authorization_required");
+        return event("no_token");
+    }
+
+    public static String failure(Exception exception) {
+        if (exception instanceof OperationCanceledException) return event("cancelled");
+        if (exception instanceof AuthenticatorException) return event("authenticator_error");
+        if (exception instanceof IOException) return ioFailure(exception);
+        if (exception instanceof SecurityException) return event("access_denied");
+        return event("unexpected_error");
+    }
+
+    public static String event(String name) { return event(name, null); }
+
+    // AccountManager may wrap NetworkErrorException (and Google's error) in an
+    // IOException message. Copy only fixed, recognized identifiers, never that
+    // message or an arbitrary server-provided value.
+    private static String ioFailure(Exception exception) {
+        try {
+            JSONObject json = new JSONObject(event("io_error"));
+            Pattern transport = Pattern.compile("\\b(UnknownHostException|SocketTimeoutException|ConnectException|SSLHandshakeException|SSLPeerUnverifiedException|NotOkayException)\\b");
+            Pattern auth = Pattern.compile("(?:NotOkayException:\\s*|\\bError=)(BadAuthentication|NeedsBrowser|NeedsPermission|ServiceDisabled|SERVICE_DISABLED|SERVICE_UNAVAILABLE|ScopeLimitExceeded|AccessDenied|UNREGISTERED_ON_API_CONSOLE|INVALID_SCOPE|InvalidScope|BadRequest|InvalidValue|Unknown)(?=$|[\\s,;])");
+            Throwable cause = exception;
+            for (int i = 0; cause != null && i < 4; i++, cause = cause.getCause()) {
+                String message = cause.getClass().getName() + ": " + cause.getMessage();
+                Matcher match = transport.matcher(message);
+                if (match.find()) json.put("io_hint", match.group(1));
+                match = auth.matcher(message);
+                if (match.find()) json.put("auth_error_hint", match.group(1));
+            }
+            return json.toString();
+        } catch (JSONException impossible) { throw new IllegalStateException(impossible); }
+    }
+
+    private static String event(String name, Integer errorCode) {
+        try {
+            JSONObject json = new JSONObject().put("event", name).put("scope", SCOPE)
+                    .put("token_exposed", false).put("payment_attempted", false);
+            if (errorCode != null) json.put("error_code", errorCode);
+            return json.toString();
+        } catch (JSONException impossible) { throw new IllegalStateException(impossible); }
+    }
+}
