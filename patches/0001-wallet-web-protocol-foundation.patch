diff --git a/wallet-web-core/src/test/java/org/microg/gms/wallet/web/WebPaymentBridgeTest.java b/wallet-web-core/src/test/java/org/microg/gms/wallet/web/WebPaymentBridgeTest.java
new file mode 100644
index 0000000..7d1a8db
--- /dev/null
+++ b/wallet-web-core/src/test/java/org/microg/gms/wallet/web/WebPaymentBridgeTest.java
@@ -0,0 +1,232 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.gms.wallet.web;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Bundle;
+import android.os.Parcel;
+import android.os.Process;
+import android.os.Looper;
+import android.os.RemoteException;
+import com.google.android.gms.common.api.CommonStatusCodes;
+import com.google.android.gms.common.api.Status;
+import com.google.android.gms.wallet.GetClientTokenResponse;
+import com.google.android.gms.wallet.WebPaymentData;
+import com.google.android.gms.wallet.WebPaymentDataRequest;
+import com.google.android.gms.wallet.internal.IWalletServiceCallbacks;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.Robolectric;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.android.controller.ActivityController;
+import org.robolectric.annotation.Config;
+import org.robolectric.shadows.ShadowAlertDialog;
+import org.microg.gms.wallet.OwServiceImpl;
+import android.os.IBinder;
+import static org.junit.Assert.*;
+import static org.robolectric.Shadows.shadowOf;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 28)
+public class WebPaymentBridgeTest {
+    private final Context context = RuntimeEnvironment.getApplication();
+
+    private static final class Callback extends IWalletServiceCallbacks.Stub {
+        Status status;
+        int calls;
+        @Override public void onIsReadyToPayResponse(Status s, boolean r, Bundle b) { fail(); }
+        @Override public void onClientTokenReceived(Status s, GetClientTokenResponse r, Bundle b) { fail(); }
+        boolean disconnected;
+        @Override public void onWebPaymentDataLoaded(Status s, WebPaymentData d, Bundle b) throws RemoteException {
+            calls++;
+            status = s;
+            assertNull(d);
+            assertTrue(b.isEmpty());
+            if (disconnected) throw new RemoteException("Synthetic callback death");
+        }
+    }
+
+    // SDK-shaped fixture: the provider does not construct the source request.
+    private static WebPaymentDataRequest request(String origin, String json) {
+        Parcel out = Parcel.obtain();
+        try {
+            out.writeInt(0xffff4f45); out.writeInt(0);
+            field(out, 3, origin);
+            field(out, 4, json);
+            out.writeInt((4 << 16) | 7); out.writeInt(1);
+            int end = out.dataPosition();
+            out.setDataPosition(4); out.writeInt(end - 8); out.setDataPosition(0);
+            return WebPaymentDataRequest.CREATOR.createFromParcel(out);
+        } finally { out.recycle(); }
+    }
+
+    private static void field(Parcel out, int id, String value) {
+        out.writeInt(0xffff0000 | id); out.writeInt(0);
+        int start = out.dataPosition(); out.writeString(value); int end = out.dataPosition();
+        out.setDataPosition(start - 4); out.writeInt(end - start); out.setDataPosition(end);
+    }
+
+    private Callback load(WebPaymentDataRequest request, Bundle options) throws RemoteException {
+        Callback callback = new Callback();
+        new WebPaymentBridge(context, Process.myUid(), context.getPackageName()).load(request, options, callback);
+        assertEquals(1, callback.calls);
+        return callback;
+    }
+
+    private Intent resolutionIntent() throws RemoteException {
+        Status status = load(request("https://merchant.example", "{\"apiVersion\":2}"), Bundle.EMPTY).status;
+        assertEquals(CommonStatusCodes.RESOLUTION_REQUIRED, status.getStatusCode());
+        assertTrue(status.hasResolution());
+        return shadowOf(status.getResolution()).getSavedIntent();
+    }
+
+    @Test public void validRequestGetsAnExplicitImmutableOneShotResolution() throws Exception {
+        Callback callback = load(request("https://merchant.example", "{\"apiVersion\":2}"), Bundle.EMPTY);
+        PendingIntent pending = callback.status.getResolution();
+        assertNotNull(pending);
+        int flags = shadowOf(pending).getFlags();
+        assertTrue((flags & PendingIntent.FLAG_IMMUTABLE) != 0);
+        assertTrue((flags & PendingIntent.FLAG_ONE_SHOT) != 0);
+        Intent intent = shadowOf(pending).getSavedIntent();
+        assertEquals(WebPaymentActivity.class.getName(), intent.getComponent().getClassName());
+        WebPaymentDataRequest preserved = intent.getParcelableExtra(WebPaymentBridge.REQUEST);
+        assertEquals("https://merchant.example", preserved.getMerchantOrigin());
+        assertEquals("{\"apiVersion\":2}", preserved.getWalletParameters());
+        assertEquals(context.getPackageName(), intent.getStringExtra(WebPaymentBridge.CALLER));
+    }
+
+    @Test public void separateRequestsCannotOverwriteEachOthersPendingIntent() throws Exception {
+        Intent first = resolutionIntent();
+        Intent second = resolutionIntent();
+        assertNotEquals(first.getData(), second.getData());
+    }
+
+    @Test public void malformedOriginsAndJsonFailWithoutAResolution() throws Exception {
+        String[] badOrigins = {null, "http://merchant.example", "https://user@merchant.example", "https://merchant.example/path", "https://merchant.example?x=1", "https://merchant.example#fragment", "https://merchant.example:0"};
+        for (String origin : badOrigins) {
+            Status status = load(request(origin, "{}"), Bundle.EMPTY).status;
+            assertEquals(CommonStatusCodes.DEVELOPER_ERROR, status.getStatusCode());
+            assertFalse(status.hasResolution());
+        }
+        assertEquals(CommonStatusCodes.DEVELOPER_ERROR,
+                load(request("https://merchant.example", "not-json"), Bundle.EMPTY).status.getStatusCode());
+    }
+
+    @Test public void forgedOptionsCannotChangeTheVerifiedPackage() throws Exception {
+        Bundle options = new Bundle(); options.putString("androidPackageName", "another.package");
+        Status status = load(request("https://merchant.example", "{}"), options).status;
+        assertEquals(CommonStatusCodes.DEVELOPER_ERROR, status.getStatusCode());
+        assertFalse(status.hasResolution());
+    }
+
+    @Test public void aBinderHandleCannotBeReusedByAnotherUid() throws Exception {
+        Callback callback = new Callback();
+        try {
+            new WebPaymentBridge(context, Process.myUid() + 1, context.getPackageName())
+                    .load(request("https://merchant.example", "{}"), Bundle.EMPTY, callback);
+            fail("Expected UID rejection");
+        } catch (SecurityException expected) { assertEquals(0, callback.calls); }
+    }
+
+    @Test public void errorUiReturnsBothSdkAndLegacyErrorFormats() throws Exception {
+        try (ActivityController<WebPaymentActivity> controller = Robolectric.buildActivity(WebPaymentActivity.class, resolutionIntent()).setup()) {
+            AlertDialog dialog = ShadowAlertDialog.getLatestAlertDialog();
+            assertNotNull(dialog);
+            dialog.getButton(AlertDialog.BUTTON_POSITIVE).performClick();
+            shadowOf(Looper.getMainLooper()).idle();
+            WebPaymentActivity activity = controller.get();
+            assertTrue(activity.isFinishing());
+            assertEquals(Activity.RESULT_FIRST_USER, shadowOf(activity).getResultCode());
+            Intent result = shadowOf(activity).getResultIntent();
+            Status status = result.getParcelableExtra(WebPaymentResults.STATUS);
+            assertEquals(CommonStatusCodes.API_NOT_CONNECTED, status.getStatusCode());
+            assertEquals(CommonStatusCodes.API_NOT_CONNECTED, result.getIntExtra(WebPaymentResults.ERROR_CODE, -1));
+            assertFalse(result.hasExtra("com.google.android.gms.wallet.WebPaymentData"));
+        }
+    }
+
+    @Test public void cancellationDoesNotTurnIntoSuccess() throws Exception {
+        try (ActivityController<WebPaymentActivity> controller = Robolectric.buildActivity(WebPaymentActivity.class, resolutionIntent()).setup()) {
+            ShadowAlertDialog.getLatestAlertDialog().getButton(AlertDialog.BUTTON_NEGATIVE).performClick();
+            shadowOf(Looper.getMainLooper()).idle();
+            assertEquals(Activity.RESULT_CANCELED, shadowOf(controller.get()).getResultCode());
+            Status result = shadowOf(controller.get()).getResultIntent().getParcelableExtra(WebPaymentResults.STATUS);
+            assertEquals(CommonStatusCodes.CANCELED, result.getStatusCode());
+        }
+    }
+
+    @Test public void expiredRequestCompletesWithTimeoutInsteadOfOpeningUi() throws Exception {
+        Intent intent = resolutionIntent().putExtra(WebPaymentBridge.EXPIRES, 0L);
+        try (ActivityController<WebPaymentActivity> controller = Robolectric.buildActivity(WebPaymentActivity.class, intent).create()) {
+            assertTrue(controller.get().isFinishing());
+            Status result = shadowOf(controller.get()).getResultIntent().getParcelableExtra(WebPaymentResults.STATUS);
+            assertEquals(CommonStatusCodes.TIMEOUT, result.getStatusCode());
+        }
+    }
+
+    @Test public void aSuccessOrResolutionStatusCannotBecomeATerminalErrorResult() {
+        try { WebPaymentResults.error(Status.SUCCESS); fail(); } catch (IllegalArgumentException expected) {}
+        PendingIntent intent = PendingIntent.getActivity(context, 42, new Intent("test"), PendingIntent.FLAG_IMMUTABLE);
+        try { WebPaymentResults.error(new Status(CommonStatusCodes.RESOLUTION_REQUIRED, "ui", intent)); fail(); }
+        catch (IllegalArgumentException expected) {}
+    }
+
+    @Test public void actualServiceDispatchesSdkTransaction17ToNativeResolution() throws Exception {
+        OwServiceImpl service = new OwServiceImpl(context, Process.myUid(), context.getPackageName());
+        Callback callback = new Callback();
+        Parcel data = Parcel.obtain();
+        try {
+            data.writeInterfaceToken("com.google.android.gms.wallet.internal.IOwService");
+            data.writeInt(1);
+            request("https://merchant.example", "{\"apiVersion\":2}").writeToParcel(data, 0);
+            data.writeInt(1); new Bundle().writeToParcel(data, 0);
+            data.writeStrongBinder(callback.asBinder());
+            assertTrue(service.transact(17, data, null, IBinder.FLAG_ONEWAY));
+            assertEquals(1, callback.calls);
+            assertEquals(CommonStatusCodes.RESOLUTION_REQUIRED, callback.status.getStatusCode());
+            assertNotNull(callback.status.getResolution());
+        } finally { data.recycle(); }
+    }
+
+    @Test public void serviceDoesNotAdvertiseReadinessWithoutAPaymentBackend() throws Exception {
+        boolean[] called = {false};
+        new OwServiceImpl(context, Process.myUid(), context.getPackageName()).isReadyToPay(null, Bundle.EMPTY,
+                new IWalletServiceCallbacks.Stub() {
+                    @Override public void onIsReadyToPayResponse(Status status, boolean ready, Bundle extras) {
+                        assertTrue(status.isSuccess()); assertFalse(ready); called[0] = true;
+                    }
+                    @Override public void onClientTokenReceived(Status s, GetClientTokenResponse r, Bundle b) { fail(); }
+                    @Override public void onWebPaymentDataLoaded(Status s, WebPaymentData d, Bundle b) { fail(); }
+                });
+        assertTrue(called[0]);
+    }
+
+    @Test public void aDeadCallbackRevokesItsUnusedResolution() throws Exception {
+        Callback callback = new Callback(); callback.disconnected = true;
+        try {
+            new WebPaymentBridge(context, Process.myUid(), context.getPackageName())
+                    .load(request("https://merchant.example", "{}"), Bundle.EMPTY, callback);
+            fail();
+        } catch (RemoteException expected) {
+            assertEquals(1, callback.calls);
+            try { callback.status.getResolution().send(); fail("Resolution should be cancelled"); }
+            catch (PendingIntent.CanceledException cancelled) {}
+        }
+    }
+
+    @Test public void malformedActivityInputCannotFallThroughToSuccess() {
+        Intent intent = new Intent(context, WebPaymentActivity.class)
+                .putExtra(WebPaymentBridge.EXPIRES, Long.MAX_VALUE)
+                .putExtra(WebPaymentBridge.CALLER, context.getPackageName());
+        try (ActivityController<WebPaymentActivity> controller = Robolectric.buildActivity(WebPaymentActivity.class, intent).create()) {
+            assertTrue(controller.get().isFinishing());
+            assertEquals(Activity.RESULT_FIRST_USER, shadowOf(controller.get()).getResultCode());
+            Status status = shadowOf(controller.get()).getResultIntent().getParcelableExtra(WebPaymentResults.STATUS);
+            assertEquals(CommonStatusCodes.DEVELOPER_ERROR, status.getStatusCode());
+        }
+    }
+}
