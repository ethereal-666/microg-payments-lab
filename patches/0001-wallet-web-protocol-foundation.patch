@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.wallet.authprobe;
+
+import android.accounts.AccountManager;
+import android.accounts.AuthenticatorException;
+import android.os.Bundle;
+import org.json.JSONObject;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+import static org.junit.Assert.*;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(manifest = Config.NONE, sdk = 28)
+public class AuthProbeReportTest {
+    @Test public void tokenAndAccountNeverEnterTheDiagnostic() throws Exception {
+        Bundle response = new Bundle();
+        response.putString(AccountManager.KEY_AUTHTOKEN, "synthetic-secret-for-redaction-test");
+        response.putString(AccountManager.KEY_ACCOUNT_NAME, "synthetic-account@example.invalid");
+        response.putString("arbitrary_extra", "another-private-value");
+        String report = AuthProbeReport.result(response);
+        assertFalse(report.contains("synthetic-secret"));
+        assertFalse(report.contains("synthetic-account"));
+        assertFalse(report.contains("another-private-value"));
+        JSONObject json = new JSONObject(report);
+        assertEquals("token_acquired", json.getString("event"));
+        assertFalse(json.getBoolean("payment_attempted"));
+        assertFalse(json.getBoolean("token_exposed"));
+    }
+
+    @Test public void serverErrorMessagesAreNotCopiedIntoReports() throws Exception {
+        Bundle response = new Bundle();
+        response.putInt(AccountManager.KEY_ERROR_CODE, AccountManager.ERROR_CODE_UNSUPPORTED_OPERATION);
+        response.putString(AccountManager.KEY_ERROR_MESSAGE, "private error description with an account identifier");
+        String report = AuthProbeReport.result(response);
+        assertFalse(report.contains("private error description"));
+        assertEquals("authenticator_error", new JSONObject(report).getString("event"));
+        assertEquals(AccountManager.ERROR_CODE_UNSUPPORTED_OPERATION, new JSONObject(report).getInt("error_code"));
+    }
+
+    @Test public void exceptionMessagesCannotLeakAccountOrTokenData() throws Exception {
+        String report = AuthProbeReport.failure(new AuthenticatorException("private error content"));
+        assertFalse(report.contains("private error content"));
+        assertEquals("authenticator_error", new JSONObject(report).getString("event"));
+    }
+
+    @Test public void emptyTokenDoesNotCountAsAuthorized() throws Exception {
+        Bundle response = new Bundle(); response.putString(AccountManager.KEY_AUTHTOKEN, "");
+        assertEquals("no_token", new JSONObject(AuthProbeReport.result(response)).getString("event"));
+    }
+}
