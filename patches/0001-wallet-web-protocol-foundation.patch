+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.wallet.authprobe;
+
+import android.os.Bundle;
+import android.app.Instrumentation;
+import android.content.Intent;
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import androidx.test.platform.app.InstrumentationRegistry;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.ByteArrayOutputStream;
+import java.nio.charset.StandardCharsets;
+import org.json.JSONObject;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import static org.junit.Assert.*;
+
+/** Diagnostic observation: a passing test does not mean authorization succeeded. */
+@RunWith(AndroidJUnit4.class)
+public class AuthProbeDeviceTest {
+    @Test public void observePreviouslyVisibleAccountWithoutGrantingNewAccess() throws Exception {
+        File file = new File(InstrumentationRegistry.getInstrumentation().getTargetContext().getFilesDir(), "events.jsonl");
+        long before = file.exists() ? file.length() : 0;
+        Instrumentation instrumentation = InstrumentationRegistry.getInstrumentation();
+        AuthProbeActivity activity = (AuthProbeActivity) instrumentation.startActivitySync(
+                new Intent(instrumentation.getTargetContext(), AuthProbeActivity.class)
+                        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK));
+        try {
+            instrumentation.runOnMainSync(activity::retrySingleVisibleAccount);
+            long deadline = android.os.SystemClock.elapsedRealtime() + 45000;
+            while ((!file.exists() || file.length() <= before) && android.os.SystemClock.elapsedRealtime() < deadline) Thread.sleep(100);
+            assertTrue("No diagnostic response within 45 seconds", file.exists() && file.length() > before);
+            byte[] bytes;
+            try (FileInputStream input = new FileInputStream(file); ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+                byte[] buffer = new byte[1024]; int count;
+                while ((count = input.read(buffer)) != -1) out.write(buffer, 0, count);
+                bytes = out.toByteArray();
+            }
+            String[] lines = new String(bytes, StandardCharsets.UTF_8).trim().split("\n");
+            JSONObject result = new JSONObject(lines[lines.length - 1]);
+            assertFalse(result.getBoolean("token_exposed"));
+            assertFalse(result.getBoolean("payment_attempted"));
+            Bundle status = new Bundle(); status.putString("diagnostic", result.toString());
+            InstrumentationRegistry.getInstrumentation().sendStatus(0, status);
+        } finally { instrumentation.runOnMainSync(activity::finish); instrumentation.waitForIdleSync(); }
+    }
+}
