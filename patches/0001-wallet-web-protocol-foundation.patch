--- /dev/null
+++ b/wallet-web-harness/src/main/java/org/microg/wallet/lab/HarnessActivity.java
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.wallet.lab;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.Process;
+import android.os.RemoteException;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import com.google.android.gms.common.api.CommonStatusCodes;
+import com.google.android.gms.common.api.Status;
+import com.google.android.gms.wallet.GetClientTokenRequest;
+import com.google.android.gms.wallet.GetClientTokenResponse;
+import com.google.android.gms.wallet.IsReadyToPayRequest;
+import com.google.android.gms.wallet.WebPaymentData;
+import com.google.android.gms.wallet.WebPaymentDataRequest;
+import com.google.android.gms.wallet.internal.IOwService;
+import com.google.android.gms.wallet.internal.IWalletServiceCallbacks;
+import org.microg.gms.wallet.OwServiceImpl;
+import org.microg.gms.wallet.web.WebPaymentResults;
+import java.io.FileOutputStream;
+import java.nio.charset.StandardCharsets;
+
+/** Exercises the real bridge through Binder 17 without touching installed GMS. */
+public final class HarnessActivity extends Activity {
+    private TextView output;
+    private String text = "This is an offline protocol test. No Google account or network access is requested.\n";
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        if (state != null) text = state.getString("output", text);
+        LinearLayout layout = new LinearLayout(this);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        int padding = (int) (20 * getResources().getDisplayMetrics().density);
+        layout.setPadding(padding, padding, padding, padding);
+        output = new TextView(this); output.setText(text); layout.addView(output);
+        Button button = new Button(this); button.setText("Test native UI and return flow");
+        button.setOnClickListener(view -> runTest()); layout.addView(button);
+        setContentView(layout);
+    }
+
+    @Override protected void onSaveInstanceState(Bundle state) {
+        state.putString("output", text);
+        super.onSaveInstanceState(state);
+    }
+
+    private void event(String line) {
+        text += line + "\n"; output.setText(text);
+        try (FileOutputStream stream = openFileOutput("events.txt", MODE_APPEND)) {
+            stream.write((line + "\n").getBytes(StandardCharsets.UTF_8));
+        } catch (Exception ignored) {}
+    }
+
+    private void runTest() {
+        IOwService.Stub service = new OwServiceImpl(this, Process.myUid(), getPackageName());
+        IWalletServiceCallbacks callback = new IWalletServiceCallbacks.Stub() {
+            @Override public void onIsReadyToPayResponse(Status s, boolean r, Bundle b) {}
+            @Override public void onClientTokenReceived(Status s, GetClientTokenResponse r, Bundle b) {}
+            @Override public void onWebPaymentDataLoaded(Status status, WebPaymentData data, Bundle extras) {
+                event("CALLBACK transaction=12 status=" + status.getStatusCode() + " paymentData=" + (data != null));
+                if (status.getStatusCode() == CommonStatusCodes.RESOLUTION_REQUIRED && status.hasResolution()) {
+                    try { startIntentSenderForResult(status.getResolution().getIntentSender(), 17, null, 0, 0, 0); }
+                    catch (Exception exception) { event("LAUNCH_FAILED " + exception.getClass().getSimpleName()); }
+                }
+            }
+        };
+        Parcel request = Parcel.obtain();
+        try {
+            request.writeInterfaceToken("com.google.android.gms.wallet.internal.IOwService");
+            request.writeInt(1);
+            int header = request.dataPosition(); request.writeInt(0xffff4f45); request.writeInt(0);
+            string(request, 3, "https://merchant.example");
+            string(request, 4, "{\"apiVersion\":2,\"environment\":\"TEST\"}");
+            int end = request.dataPosition(); request.setDataPosition(header + 4); request.writeInt(end - header - 8); request.setDataPosition(end);
+            request.writeInt(1); new Bundle().writeToParcel(request, 0);
+            request.writeStrongBinder(callback.asBinder());
+            event("REQUEST transaction=17");
+            service.transact(17, request, null, IBinder.FLAG_ONEWAY);
+        } catch (Exception exception) { event("REQUEST_FAILED " + exception.getClass().getSimpleName()); }
+        finally { request.recycle(); }
+    }
+
+    private static void string(Parcel out, int id, String value) {
+        out.writeInt(0xffff0000 | id); out.writeInt(0); int start = out.dataPosition();
+        out.writeString(value); int end = out.dataPosition(); out.setDataPosition(start - 4);
+        out.writeInt(end - start); out.setDataPosition(end);
+    }
+
+    @Override protected void onActivityResult(int request, int result, Intent data) {
+        super.onActivityResult(request, result, data);
+        if (request != 17) return;
+        Status status = data == null ? null : data.getParcelableExtra(WebPaymentResults.STATUS);
+        event("RESULT activity=" + result + " status=" + (status == null ? "none" : status.getStatusCode()));
+        if (result == RESULT_OK) event("UNEXPECTED_OK: no backend should return success");
+    }
+}
