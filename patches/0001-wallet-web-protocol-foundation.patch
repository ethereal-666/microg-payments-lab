+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.gms.wallet.web;
+
+import android.content.Intent;
+import com.google.android.gms.common.api.Status;
+
+/** Activity-result formats used by Wallet SDK clients and Chrome's legacy path. */
+public final class WebPaymentResults {
+    public static final String STATUS = "com.google.android.gms.common.api.AutoResolveHelper.status";
+    public static final String ERROR_CODE = "com.google.android.gms.wallet.EXTRA_ERROR_CODE";
+    public static final String ERROR_MESSAGE = "com.google.android.gms.wallet.EXTRA_ERROR_MESSAGE";
+
+    private WebPaymentResults() {}
+
+    public static Intent error(Status status) {
+        if (status == null || status.isSuccess() || status.hasResolution()) {
+            throw new IllegalArgumentException("A terminal non-success status is required");
+        }
+        return new Intent().putExtra(STATUS, status)
+                .putExtra(ERROR_CODE, status.getStatusCode())
+                .putExtra(ERROR_MESSAGE, status.getStatusMessage());
+    }
+}
