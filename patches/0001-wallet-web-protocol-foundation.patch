@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.gms.wallet.web;
+
+import android.accounts.Account;
+import android.accounts.AccountManager;
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import com.google.android.gms.BuildConfig;
+import org.json.JSONObject;
+import org.microg.gms.auth.AuthManager;
+import org.microg.gms.auth.AuthResponse;
+import java.io.FileOutputStream;
+import java.nio.charset.StandardCharsets;
+
+/** Fixed-scope observation from inside the actual authenticator package, not a companion identity. */
+public final class WalletFrameworkDiagnosticActivity extends Activity {
+    private static final String SCOPE = "oauth2:https://www.googleapis.com/auth/sierra";
+    private TextView output;
+    private Button start;
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        if (!BuildConfig.DEBUG || !getPackageName().equals("com.google.android.gms")) {
+            finish(); return;
+        }
+        LinearLayout layout = new LinearLayout(this); layout.setOrientation(LinearLayout.VERTICAL);
+        int padding = (int) (20 * getResources().getDisplayMetrics().density);
+        layout.setPadding(padding, padding, padding, padding);
+        output = new TextView(this);
+        output.setText("Framework Sierra authorization diagnostic. No card lookup, initialization or payment is performed.");
+        layout.addView(output);
+        start = new Button(this); start.setText("Check authorization inside GmsCore");
+        start.setOnClickListener(view -> check()); layout.addView(start);
+        Button login = new Button(this); login.setText("Sign in to test account");
+        login.setOnClickListener(view -> startActivity(new Intent(this, org.microg.gms.auth.login.LoginActivity.class)));
+        layout.addView(login); setContentView(layout);
+        if (state == null && getIntent().getBooleanExtra("run", false)) check();
+    }
+
+    private void check() {
+        start.setEnabled(false);
+        new Thread(() -> {
+            try {
+                Account[] accounts = AccountManager.get(this).getAccountsByType("com.google");
+                if (accounts.length != 1) {
+                    report(accounts.length == 0 ? "no_account" : "multiple_accounts", null); return;
+                }
+                // This code runs inside com.google.android.gms. isGmsApp is the
+                // existing microG internal mode also used by its consent code.
+                // It is never offered to an external Binder caller or given an
+                // arbitrary package, account name, scope or certificate extra.
+                AuthManager manager = new AuthManager(this, accounts[0].name, getPackageName(), SCOPE);
+                manager.setAccountType("com.google");
+                manager.isGmsApp = true;
+                manager.setOauth2Foreground("1");
+                AuthResponse response = manager.requestAuth(false);
+                report(response.auth != null && !response.auth.isEmpty() ? "token_acquired" : "authorization_required", null);
+            } catch (Exception failure) {
+                // Copy fixed identifiers only, never exception/server content.
+                String message = failure.getMessage();
+                String hint = null;
+                for (String allowed : new String[]{"INVALID_SCOPE", "UNREGISTERED_ON_API_CONSOLE", "BadAuthentication", "NeedsBrowser", "NeedsPermission"}) {
+                    if (message != null && message.matches("(?s).*(?:^|[\\s=:])" + allowed + "(?:$|[\\s,;]).*")) hint = allowed;
+                }
+                report("authorization_error", hint);
+            }
+        }, "wallet-framework-auth").start();
+    }
+
+    private void report(String event, String hint) {
+        try {
+            JSONObject result = new JSONObject().put("event", event).put("scope", SCOPE)
+                    .put("caller_context", "gmscore_internal").put("token_exposed", false)
+                    .put("payment_attempted", false);
+            if (hint != null) result.put("auth_error_hint", hint);
+            String text = result.toString();
+            try (FileOutputStream file = openFileOutput("wallet-framework-report.json", MODE_PRIVATE)) {
+                file.write((text + "\n").getBytes(StandardCharsets.UTF_8));
+            }
+            runOnUiThread(() -> { if (!isDestroyed()) { output.setText(text); start.setEnabled(true); } });
+        } catch (Exception ignored) {}
+    }
+}
