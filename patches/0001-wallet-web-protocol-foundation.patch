+/*
+ * SPDX-FileCopyrightText: 2026 microG Project Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.microg.gms.wallet;
+
+import android.os.Binder;
+import android.os.Bundle;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Parcel;
+import android.os.RemoteException;
+import android.app.PendingIntent;
+import android.content.Intent;
+
+import com.google.android.gms.common.api.CommonStatusCodes;
+import com.google.android.gms.common.api.Status;
+import com.google.android.gms.wallet.GetClientTokenRequest;
+import com.google.android.gms.wallet.IsReadyToPayRequest;
+import com.google.android.gms.wallet.WebPaymentData;
+import com.google.android.gms.wallet.WebPaymentDataRequest;
+import com.google.android.gms.wallet.LineItem;
+import com.google.android.gms.wallet.internal.IOwService;
+import com.google.android.gms.wallet.internal.IWalletServiceCallbacks;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+import org.robolectric.RuntimeEnvironment;
+
+import java.lang.reflect.Field;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Consumer;
+
+import static org.junit.Assert.*;
+
+/** Contract taken from Google's Wallet SDK 20.0.0, rather than AIDL constants. */
+@RunWith(RobolectricTestRunner.class)
+@Config(manifest = Config.NONE, sdk = 28)
+public class WebPaymentWireTest {
+    private static final String SERVICE = "com.google.android.gms.wallet.internal.IOwService";
+    private static final String CALLBACK = "com.google.android.gms.wallet.internal.IWalletServiceCallbacks";
+
+    // Write the SDK's SafeParcel framing directly, independently of microG's writer.
+    private static int beginVariable(Parcel out, int fieldId) {
+        out.writeInt(0xffff0000 | fieldId);
+        out.writeInt(0);
+        return out.dataPosition();
+    }
+
+    private static void finishVariable(Parcel out, int start) {
+        int end = out.dataPosition();
+        out.setDataPosition(start - 4);
+        out.writeInt(end - start);
+        out.setDataPosition(end);
+    }
+
+    private static void writeField(Parcel out, int id, Consumer<Parcel> writer) {
+        int start = beginVariable(out, id);
+        writer.accept(out);
+        finishVariable(out, start);
+    }
+
+    /** Includes legacy field 2 so a reader cannot accidentally consume outer IPC data. */
+    private static void writeSdkRequest(Parcel parcel) {
+        parcel.writeInt(1);
+        int start = beginVariable(parcel, 20293);
+        writeField(parcel, 2, out -> {
+            int cart = beginVariable(out, 20293);
+            writeField(out, 2, p -> p.writeString("1.00"));
+            writeField(out, 3, p -> p.writeString("USD"));
+            finishVariable(out, cart);
+        });
+        writeField(parcel, 3, p -> p.writeString("https://merchant.example"));
+        writeField(parcel, 4, p -> p.writeString("synthetic-wallet-parameters"));
+        Bundle saved = new Bundle();
+        saved.putString("saved", "state");
+        writeField(parcel, 5, p -> p.writeBundle(saved));
+        writeField(parcel, 6, p -> p.writeByteArray(new byte[] {1, 2, 3}));
+        parcel.writeInt((4 << 16) | 7);
+        parcel.writeInt(1);
+        writeField(parcel, 99, p -> p.writeString("future-field"));
+        finishVariable(parcel, start);
+    }
+
+    private static Object field(Object object, String name) throws Exception {
+        Field f = object.getClass().getDeclaredField(name);
+        f.setAccessible(true);
+        return f.get(object);
+    }
+
+    @Test public void requestParserPreservesTheFollowingBinderArguments() throws Exception {
+        Parcel parcel = Parcel.obtain();
+        try {
+            writeSdkRequest(parcel);
+            parcel.writeString("outer-argument-sentinel");
+            parcel.setDataPosition(0);
+            assertEquals(1, parcel.readInt());
+            WebPaymentDataRequest request = WebPaymentDataRequest.CREATOR.createFromParcel(parcel);
+            assertEquals("1.00", request.getCart().getTotalPrice());
+            assertEquals("USD", request.getCart().getCurrencyCode());
+            assertTrue(request.getCart().getLineItems().isEmpty());
+            assertEquals("https://merchant.example", field(request, "merchantOrigin"));
+            assertEquals("synthetic-wallet-parameters", field(request, "walletParameters"));
+            assertArrayEquals(new byte[] {1, 2, 3}, (byte[]) field(request, "encryptedParameters"));
+            assertEquals(true, field(request, "useChromiumPaymentDetailsUpdate"));
+            assertEquals("state", ((Bundle) field(request, "savedState")).getString("saved"));
+            assertEquals("outer-argument-sentinel", parcel.readString());
+            assertEquals(0, parcel.dataAvail());
+        } finally {
+            parcel.recycle();
+        }
+    }
+
+    @Test public void cartRetainsMultipleSdkLineItemsAndUnknownFields() throws Exception {
+        Parcel parcel = Parcel.obtain();
+        try {
+            int cart = beginVariable(parcel, 20293);
+            writeField(parcel, 2, p -> p.writeString("12.50"));
+            writeField(parcel, 3, p -> p.writeString("USD"));
+            writeField(parcel, 4, p -> {
+                p.writeInt(2);
+                for (int i = 0; i < 2; i++) {
+                    // Google's SafeParcelWriter prefixes each typed-list item
+                    // with its encoded byte length, rather than just 1.
+                    p.writeInt(0);
+                    int itemStart = p.dataPosition();
+                    int item = beginVariable(p, 20293);
+                    final String description = i == 0 ? "synthetic item" : "synthetic tax";
+                    writeField(p, 2, q -> q.writeString(description));
+                    writeField(p, 3, q -> q.writeString("1"));
+                    writeField(p, 4, q -> q.writeString("6.25"));
+                    writeField(p, 5, q -> q.writeString("6.25"));
+                    p.writeInt((4 << 16) | 6);
+                    p.writeInt(i == 0 ? 0 : 1);
+                    writeField(p, 7, q -> q.writeString("USD"));
+                    writeField(p, 99, q -> q.writeString("future line-item field"));
+                    finishVariable(p, item);
+                    finishVariable(p, itemStart);
+                }
+            });
+            finishVariable(parcel, cart);
+            parcel.writeString("outer-sentinel");
+            parcel.setDataPosition(0);
+            com.google.android.gms.wallet.Cart decoded = com.google.android.gms.wallet.Cart.CREATOR.createFromParcel(parcel);
+            assertEquals(2, decoded.getLineItems().size());
+            LineItem second = decoded.getLineItems().get(1);
+            assertEquals("synthetic tax", second.getDescription());
+            assertEquals("1", second.getQuantity());
+            assertEquals("6.25", second.getUnitPrice());
+            assertEquals("6.25", second.getTotalPrice());
+            assertEquals(1, second.getRole());
+            assertEquals("USD", second.getCurrencyCode());
+            assertEquals("outer-sentinel", parcel.readString());
+            assertEquals(0, parcel.dataAvail());
+        } finally { parcel.recycle(); }
+    }
+
+    @Test public void callback12PreservesNativeUiResolutionWithoutPaymentData() throws Exception {
+        Intent intent = new Intent("org.microg.wallet.TEST_RESOLUTION").setPackage(RuntimeEnvironment.getApplication().getPackageName());
+        PendingIntent resolution = PendingIntent.getActivity(RuntimeEnvironment.getApplication(), 71, intent, PendingIntent.FLAG_IMMUTABLE);
+        AtomicInteger calls = new AtomicInteger();
+        Binder receiver = new Binder() {
+            @Override public IInterface queryLocalInterface(String descriptor) { return null; }
+            @Override protected boolean onTransact(int code, Parcel data, Parcel reply, int flags) {
+                assertEquals(12, code);
+                assertEquals(IBinder.FLAG_ONEWAY, flags);
+                assertNull(reply);
+                data.enforceInterface(CALLBACK);
+                assertEquals(1, data.readInt());
+                Status status = Status.CREATOR.createFromParcel(data);
+                assertEquals(CommonStatusCodes.RESOLUTION_REQUIRED, status.getStatusCode());
+                assertTrue(status.hasResolution());
+                assertEquals(resolution, status.getResolution());
+                assertEquals(0, data.readInt());
+                assertEquals(1, data.readInt());
+                assertTrue(Bundle.CREATOR.createFromParcel(data).isEmpty());
+                assertEquals(0, data.dataAvail());
+                calls.incrementAndGet();
+                return true;
+            }
+        };
+        IWalletServiceCallbacks.Stub.asInterface(receiver).onWebPaymentDataLoaded(
+                new Status(CommonStatusCodes.RESOLUTION_REQUIRED, "Test UI resolution", resolution), null, Bundle.EMPTY);
+        assertEquals(1, calls.get());
+    }
+
+    @Test public void chromeTransaction17DispatchesWithoutASynchronousReply() throws Exception {
+        AtomicInteger calls = new AtomicInteger();
+        Binder callback = new Binder();
+        IOwService.Stub service = new IOwService.Stub() {
+            @Override public void isReadyToPay(IsReadyToPayRequest r, Bundle b, IWalletServiceCallbacks c) { fail(); }
+            @Override public void getClientToken(GetClientTokenRequest r, Bundle b, IWalletServiceCallbacks c) { fail(); }
+            @Override public void loadWebPaymentData(WebPaymentDataRequest r, Bundle b, IWalletServiceCallbacks c) {
+                assertNotNull(r);
+                assertEquals("options", b.getString("marker"));
+                assertSame(callback, c.asBinder());
+                calls.incrementAndGet();
+            }
+        };
+        Parcel data = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(SERVICE);
+            writeSdkRequest(data);
+            data.writeInt(1);
+            Bundle options = new Bundle();
+            options.putString("marker", "options");
+            options.writeToParcel(data, 0);
+            data.writeStrongBinder(callback);
+            assertTrue(service.transact(17, data, null, IBinder.FLAG_ONEWAY));
+            assertEquals(1, calls.get());
+        } finally {
+            data.recycle();
+        }
+    }
+
+    @Test public void callback12ContainsAnErrorAndNoPaymentCredential() throws Exception {
+        AtomicInteger calls = new AtomicInteger();
+        Binder receiver = new Binder() {
+            @Override public IInterface queryLocalInterface(String descriptor) { return null; }
+            @Override protected boolean onTransact(int code, Parcel data, Parcel reply, int flags) throws RemoteException {
+                assertEquals(12, code);
+                assertEquals(IBinder.FLAG_ONEWAY, flags);
+                assertNull(reply);
+                data.enforceInterface(CALLBACK);
+                assertEquals(1, data.readInt());
+                Status status = Status.CREATOR.createFromParcel(data);
+                assertEquals(CommonStatusCodes.API_NOT_CONNECTED, status.getStatusCode());
+                assertFalse(status.isSuccess());
+                assertEquals(0, data.readInt()); // Nullable WebPaymentData, not an empty/fake token.
+                assertEquals(1, data.readInt());
+                Bundle extras = Bundle.CREATOR.createFromParcel(data);
+                assertTrue(extras.isEmpty());
+                assertEquals(0, data.dataAvail());
+                calls.incrementAndGet();
+                return true;
+            }
+        };
+        IWalletServiceCallbacks.Stub.asInterface(receiver).onWebPaymentDataLoaded(
+                new Status(CommonStatusCodes.API_NOT_CONNECTED, "not supported"), null, Bundle.EMPTY);
+        assertEquals(1, calls.get());
+    }
+}
