+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.wallet.lab;
+
+import android.content.Context;
+import android.app.Instrumentation;
+import android.app.Activity;
+import android.content.Intent;
+import androidx.test.runner.lifecycle.ActivityLifecycleMonitorRegistry;
+import androidx.test.runner.lifecycle.Stage;
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import androidx.test.platform.app.InstrumentationRegistry;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.ByteArrayOutputStream;
+import java.nio.charset.StandardCharsets;
+import org.microg.gms.wallet.web.R;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import static androidx.test.espresso.Espresso.*;
+import static androidx.test.espresso.action.ViewActions.click;
+import static androidx.test.espresso.assertion.ViewAssertions.*;
+import static androidx.test.espresso.matcher.ViewMatchers.*;
+import static org.junit.Assert.*;
+
+/** Actual device IPC and UI lifecycle, without accounts or network requests. */
+@RunWith(AndroidJUnit4.class)
+public class RemoteFlowTest {
+    private File events;
+
+    @Before public void clearOnlyOurTestEvents() {
+        Context context = InstrumentationRegistry.getInstrumentation().getTargetContext();
+        events = new File(context.getFilesDir(), "events.txt");
+        assertTrue(!events.exists() || events.delete());
+    }
+
+    private String trace() throws Exception {
+        if (!events.exists()) return "";
+        try (FileInputStream input = new FileInputStream(events); ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+            byte[] buffer = new byte[1024]; int count;
+            while ((count = input.read(buffer)) != -1) out.write(buffer, 0, count);
+            return new String(out.toByteArray(), StandardCharsets.UTF_8);
+        }
+    }
+
+    private void await(String marker) throws Exception {
+        long deadline = android.os.SystemClock.elapsedRealtime() + 15000;
+        while (!trace().contains(marker) && android.os.SystemClock.elapsedRealtime() < deadline) Thread.sleep(50);
+        assertTrue(trace(), trace().contains(marker));
+    }
+
+    private void checkFlow(int action, String expected) throws Exception {
+        Instrumentation instrumentation = InstrumentationRegistry.getInstrumentation();
+        Instrumentation.ActivityMonitor monitor = instrumentation.addMonitor("org.microg.gms.wallet.web.WebPaymentActivity", null, false);
+        // Use the platform launcher directly: ActivityScenario's helper EmptyActivity
+        // can retain foreground focus on this Huawei firmware between test runs.
+        instrumentation.startActivitySync(new Intent(instrumentation.getTargetContext(), HarnessActivity.class)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK));
+        instrumentation.waitForIdleSync();
+        try {
+            onView(withText("Test native UI and return flow")).perform(click());
+            await("CALLBACK transaction=12 status=6 paymentData=false remote=true");
+            assertNotNull("Payment Activity did not resume", instrumentation.waitForMonitorWithTimeout(monitor, 15000));
+            instrumentation.waitForIdleSync();
+            onView(withText(R.string.wallet_web_unavailable_title)).check(matches(isDisplayed()));
+            if (action == 0) pressBack();
+            else onView(withText(action)).perform(click());
+            await(expected);
+            String log = trace();
+            assertTrue(log, log.contains("TRANSPORT remote=true"));
+            assertFalse(log, log.contains("UNEXPECTED_OK"));
+            assertFalse(log, log.contains("FAILED"));
+        } finally {
+            instrumentation.removeMonitor(monitor);
+            instrumentation.runOnMainSync(() -> {
+                for (Stage stage : new Stage[]{Stage.RESUMED, Stage.STARTED, Stage.CREATED, Stage.PAUSED, Stage.STOPPED}) {
+                    for (Activity activity : new java.util.ArrayList<>(ActivityLifecycleMonitorRegistry.getInstance().getActivitiesInStage(stage))) {
+                        if (activity.getPackageName().equals("org.microg.wallet.lab")) activity.finish();
+                    }
+                }
+            });
+            instrumentation.waitForIdleSync();
+        }
+    }
+
+    @Test public void errorResultCrossesTheProcessBoundary() throws Exception {
+        checkFlow(R.string.wallet_web_return, "RESULT activity=1 status=17");
+    }
+    @Test public void cancellationCrossesTheProcessBoundary() throws Exception {
+        checkFlow(R.string.wallet_web_cancel, "RESULT activity=0 status=16");
+    }
+    @Test public void systemBackCrossesTheProcessBoundary() throws Exception {
+        checkFlow(0, "RESULT activity=0 status=16");
+    }
+}
