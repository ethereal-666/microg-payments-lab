+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.wallet.authprobe;
+
+import android.accounts.Account;
+import android.accounts.AccountManager;
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import java.io.FileOutputStream;
+import java.nio.charset.StandardCharsets;
+
+/** User-initiated scope-availability check against the existing authenticator. */
+public final class AuthProbeActivity extends Activity {
+    private TextView output;
+    private Button start;
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        LinearLayout layout = new LinearLayout(this); layout.setOrientation(LinearLayout.VERTICAL);
+        int padding = (int) (20 * getResources().getDisplayMetrics().density);
+        layout.setPadding(padding, padding, padding, padding);
+        TextView explanation = new TextView(this);
+        explanation.setText("支付授权可行性检查\n\n点击后选择 Google 账号，由现有 microG 处理授权；若出现授权页，请自行决定是否同意。这里只检查支付服务授权是否可用，不查询银行卡或发起付款，也不保存账号名或令牌。\n");
+        layout.addView(explanation);
+        start = new Button(this); start.setText("选择账号并检查授权");
+        start.setOnClickListener(view -> {
+            start.setEnabled(false);
+            try {
+                Intent choose = AccountManager.newChooseAccountIntent(null, null,
+                        new String[]{"com.google"}, null, null, null, null);
+                startActivityForResult(choose, 1);
+            } catch (Exception exception) { report(AuthProbeReport.failure(exception)); }
+        });
+        layout.addView(start);
+        output = new TextView(this); layout.addView(output); setContentView(layout);
+    }
+
+    @Override protected void onActivityResult(int request, int result, Intent data) {
+        super.onActivityResult(request, result, data);
+        if (request != 1) return;
+        if (result != RESULT_OK || data == null) { report(AuthProbeReport.event("cancelled")); return; }
+        String name = data.getStringExtra(AccountManager.KEY_ACCOUNT_NAME);
+        String type = data.getStringExtra(AccountManager.KEY_ACCOUNT_TYPE);
+        if (name == null || name.isEmpty() || !"com.google".equals(type)) {
+            report(AuthProbeReport.event("invalid_account_selection")); return;
+        }
+        try {
+            AccountManager.get(this).getAuthToken(new Account(name, type), AuthProbeReport.SCOPE,
+                    new Bundle(), this, future -> {
+                        try { report(AuthProbeReport.result(future.getResult())); }
+                        catch (Exception exception) { report(AuthProbeReport.failure(exception)); }
+                    }, null);
+        } catch (Exception exception) { report(AuthProbeReport.failure(exception)); }
+    }
+
+    private void report(String diagnostic) {
+        if (!isDestroyed()) { output.setText(diagnostic); start.setEnabled(true); }
+        try (FileOutputStream stream = openFileOutput("events.jsonl", MODE_APPEND)) {
+            stream.write((diagnostic + "\n").getBytes(StandardCharsets.UTF_8));
+        } catch (Exception ignored) {}
+    }
+}
diff --git a/wallet-auth-probe/src/main/java/org/microg/wallet/authprobe/AuthProbeReport.java b/wallet-auth-probe/src/main/java/org/microg/wallet/authprobe/AuthProbeReport.java
