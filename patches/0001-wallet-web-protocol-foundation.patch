+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.gms.wallet.web;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.os.Bundle;
+import android.os.SystemClock;
+import com.google.android.gms.common.api.CommonStatusCodes;
+import com.google.android.gms.common.api.Status;
+import com.google.android.gms.wallet.WebPaymentDataRequest;
+
+/** Completes native error/cancel flow while the payment backend is unavailable. */
+public final class WebPaymentActivity extends Activity {
+    private boolean finished;
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        // Even if the process is recreated, the default outcome must never be OK.
+        setResult(RESULT_FIRST_USER, WebPaymentResults.error(unavailable()));
+        try {
+            long expires = getIntent().getLongExtra(WebPaymentBridge.EXPIRES, -1);
+            if (expires <= SystemClock.elapsedRealtime()) {
+                complete(new Status(CommonStatusCodes.TIMEOUT, "Web payment request expired"));
+                return;
+            }
+            getIntent().setExtrasClassLoader(WebPaymentDataRequest.class.getClassLoader());
+            WebPaymentDataRequest request = getIntent().getParcelableExtra(WebPaymentBridge.REQUEST);
+            WebPaymentBridge.validate(request);
+            String caller = getIntent().getStringExtra(WebPaymentBridge.CALLER);
+            if (caller == null || caller.isEmpty()) throw new IllegalArgumentException("Missing caller");
+        } catch (RuntimeException exception) {
+            complete(new Status(CommonStatusCodes.DEVELOPER_ERROR, "Invalid web payment activity request"));
+            return;
+        }
+        // No card selection/confirmation is shown: no genuine payment backend
+        // has been connected. This is the terminal error UI, not a payment sheet.
+        new AlertDialog.Builder(this)
+                .setTitle(R.string.wallet_web_unavailable_title)
+                .setMessage(R.string.wallet_web_unavailable_message)
+                .setPositiveButton(R.string.wallet_web_return, (dialog, which) -> complete(unavailable()))
+                .setNegativeButton(R.string.wallet_web_cancel, (dialog, which) -> complete(Status.CANCELED))
+                .setOnCancelListener(dialog -> complete(Status.CANCELED))
+                .show();
+    }
+
+    @Override public void onBackPressed() { complete(Status.CANCELED); }
+
+    private static Status unavailable() {
+        return new Status(CommonStatusCodes.API_NOT_CONNECTED, "Google Pay backend is not implemented");
+    }
+
+    private void complete(Status status) {
+        if (finished) return;
+        finished = true;
+        setResult(status.getStatusCode() == CommonStatusCodes.CANCELED ? RESULT_CANCELED : RESULT_FIRST_USER,
+                WebPaymentResults.error(status));
+        finish();
+    }
+}
diff --git a/wallet-web-core/src/main/java/org/microg/gms/wallet/web/WebPaymentBridge.java b/wallet-web-core/src/main/java/org/microg/gms/wallet/web/WebPaymentBridge.java
new file mode 100644
index 0000000..5c5e22f
--- /dev/null
+++ b/wallet-web-core/src/main/java/org/microg/gms/wallet/web/WebPaymentBridge.java
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.gms.wallet.web;
+
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Binder;
+import android.os.Bundle;
+import android.os.Parcel;
+import android.os.RemoteException;
+import android.os.SystemClock;
+import com.google.android.gms.common.api.CommonStatusCodes;
+import com.google.android.gms.common.api.Status;
+import com.google.android.gms.wallet.WebPaymentDataRequest;
+import com.google.android.gms.wallet.internal.IWalletServiceCallbacks;
+import org.json.JSONException;
+import org.json.JSONObject;
+import java.net.URI;
+import java.net.URISyntaxException;
+import java.util.UUID;
+
+/** Native Wallet hand-off only. No Google-backed payment provider exists yet. */
+public final class WebPaymentBridge {
+    static final String REQUEST = "org.microg.wallet.web.REQUEST";
+    static final String CALLER = "org.microg.wallet.web.CALLER";
+    static final String OPTIONS = "org.microg.wallet.web.OPTIONS";
+    static final String EXPIRES = "org.microg.wallet.web.EXPIRES";
+    private static final long UI_TIMEOUT_MILLIS = 10 * 60 * 1000;
+    private static final int MAX_REQUEST_BYTES = 512 * 1024;
+    private final Context context;
+    private final int ownerUid;
+    private final String ownerPackage;
+
+    public WebPaymentBridge(Context context, int ownerUid, String ownerPackage) {
+        if (context == null || ownerPackage == null || ownerPackage.isEmpty()) {
+            throw new IllegalArgumentException("A verified caller binding is required");
+        }
+        this.context = context.getApplicationContext();
+        this.ownerUid = ownerUid;
+        this.ownerPackage = ownerPackage;
+    }
+
+    public void load(WebPaymentDataRequest request, Bundle options,
+                     IWalletServiceCallbacks callbacks) throws RemoteException {
+        // Bind every transaction to the UID validated at GetService time.
+        if (Binder.getCallingUid() != ownerUid) throw new SecurityException("Wallet caller UID mismatch");
+        if (callbacks == null) throw new IllegalArgumentException("Wallet callback is required");
+        WebPaymentDataRequest snapshot;
+        try {
+            validate(request);
+            if (options != null) {
+                String claimedPackage = options.getString("androidPackageName");
+                if (claimedPackage != null && !ownerPackage.equals(claimedPackage)) {
+                    throw new IllegalArgumentException("Wallet package binding mismatch");
+                }
+            }
+            snapshot = snapshot(request);
+        } catch (IllegalArgumentException exception) {
+            callbacks.onWebPaymentDataLoaded(new Status(CommonStatusCodes.DEVELOPER_ERROR,
+                    "Invalid web payment request"), null, Bundle.EMPTY);
+            return;
+        }
+
+        // Never inherit the browser's Binder identity when creating our capability.
+        long identity = Binder.clearCallingIdentity();
+        PendingIntent resolution;
+        try {
+            Intent intent = new Intent(context, WebPaymentActivity.class)
+                    .setData(Uri.parse("microg-wallet://web/" + UUID.randomUUID()))
+                    .putExtra(REQUEST, snapshot)
+                    .putExtra(CALLER, ownerPackage)
+                    .putExtra(EXPIRES, SystemClock.elapsedRealtime() + UI_TIMEOUT_MILLIS)
+                    .putExtra(OPTIONS, options == null ? new Bundle() : new Bundle(options));
+            resolution = PendingIntent.getActivity(context, 0, intent,
+                    PendingIntent.FLAG_ONE_SHOT | PendingIntent.FLAG_IMMUTABLE);
+        } catch (RuntimeException exception) {
+            callbacks.onWebPaymentDataLoaded(new Status(CommonStatusCodes.INTERNAL_ERROR,
+                    "Unable to create web payment UI"), null, Bundle.EMPTY);
+            return;
+        } finally {
+            Binder.restoreCallingIdentity(identity);
+        }
+        try {
+            callbacks.onWebPaymentDataLoaded(new Status(CommonStatusCodes.RESOLUTION_REQUIRED,
+                    "Web payment UI must be opened", resolution), null, Bundle.EMPTY);
+        } catch (RemoteException exception) {
+            resolution.cancel();
+            throw exception;
+        }
+    }
+
+    static void validate(WebPaymentDataRequest request) {
+        if (request == null) throw new IllegalArgumentException("Missing request");
+        try {
+            URI origin = new URI(request.getMerchantOrigin());
+            String path = origin.getRawPath();
+            int port = origin.getPort();
+            if (!"https".equalsIgnoreCase(origin.getScheme()) || origin.getHost() == null
+                    || origin.getRawUserInfo() != null || origin.getRawQuery() != null
+                    || origin.getRawFragment() != null || (path != null && !path.isEmpty() && !"/".equals(path))
+                    || port == 0 || port > 65535) throw new IllegalArgumentException("Invalid merchant origin");
+        } catch (URISyntaxException | NullPointerException exception) {
+            throw new IllegalArgumentException("Invalid merchant origin", exception);
+        }
+        String parameters = request.getWalletParameters();
+        byte[] encrypted = request.getEncryptedParameters();
+        if (parameters != null && !parameters.isEmpty()) {
+            try { new JSONObject(parameters); }
+            catch (JSONException exception) { throw new IllegalArgumentException("Invalid wallet JSON", exception); }
+        } else if (encrypted == null || encrypted.length == 0) {
+            throw new IllegalArgumentException("Missing wallet parameters");
+        }
+    }
+
+    private static WebPaymentDataRequest snapshot(WebPaymentDataRequest request) {
+        Parcel parcel = Parcel.obtain();
+        try {
+            request.writeToParcel(parcel, 0);
+            if (parcel.dataSize() > MAX_REQUEST_BYTES) throw new IllegalArgumentException("Request too large");
+            parcel.setDataPosition(0);
+            return WebPaymentDataRequest.CREATOR.createFromParcel(parcel);
+        } finally { parcel.recycle(); }
+    }
+}
