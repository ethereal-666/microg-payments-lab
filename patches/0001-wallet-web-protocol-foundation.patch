+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.wallet.authprobe;
+
+import android.content.Context;
+import android.os.Build;
+import org.json.JSONObject;
+import java.io.*;
+import java.net.*;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+import javax.net.ssl.HttpsURLConnection;
+
+/** Bounded initializer experiment only. No submit endpoint exists here. ENVIRONMENT_TEST (3) uses the standard buyflow host; environments 0/2 select the internal sandbox. */
+final class BuyflowSandboxProbe {
+    static final String URL = "https://wallet.google.com/payments/apis-secure/buyflowservice/initialize";
+    private static final String PARAMETERS = "{\"merchantName\":\"microG Payments Lab\",\"allowedCardNetworks\":[\"VISA\",\"MASTERCARD\"],\"paymentMethodTokenizationParameters\":{\"tokenizationType\":\"GATEWAY_TOKEN\",\"parameters\":{\"gateway\":\"example\",\"gatewayMerchantId\":\"exampleGatewayMerchantId\"}}}";
+    static byte[] request(String device, String sdk, String locale) {
+        // Observed API 31 buyflow schema, deliberately separate from microG IAP.
+        byte[] androidInfo=message(text(3,sdk),text(4,device),text(9,"com.google.android.gms"),text(13,"org.microg.wallet.authprobe"));
+        byte[] header=message(text(7,locale),number(8,2),number(9,252432032),bytes(10,androidInfo));
+        byte[] amount=message(number(1,1000000),text(2,"USD"));
+        byte[] web=message(bytes(2,amount),text(13,PARAMETERS));
+        byte[] unencrypted=message(number(18,9),bytes(50,web));
+        return message(bytes(1,header),bytes(4,unencrypted));
+    }
+    static String run(Context context,String token) {
+        JSONObject report=new JSONObject(); HttpsURLConnection connection=null;
+        try {
+            report.put("requested_environment","TEST").put("environment_verified",false).put("endpoint","buyflowservice/initialize")
+                .put("token_exposed",false).put("payment_attempted",false).put("payment_verified",false);
+            // Match Google's official auth library: POST with Bearer header,
+            // never place the token in a URL or persist the tokeninfo response.
+            tokenInfo(token,report);
+            byte[] body=request(Build.DEVICE,Integer.toString(Build.VERSION.SDK_INT),Locale.getDefault().toLanguageTag());
+            connection=(HttpsURLConnection)new java.net.URL(URL).openConnection();
+            connection.setInstanceFollowRedirects(false);connection.setConnectTimeout(12000);connection.setReadTimeout(20000);
+            connection.setRequestMethod("POST");connection.setDoOutput(true);
+            connection.setRequestProperty("Authorization","Bearer "+token);
+            connection.setRequestProperty("Content-Type","application/x-protobuf");
+            connection.setRequestProperty("Accept","application/x-protobuf");
+            connection.setRequestProperty("X-Modality","ANDROID_NATIVE");
+            connection.setRequestProperty("X-Version","252432032");
+            connection.setRequestProperty("User-Agent","microG-Payments-Lab/0.1 Android");
+            connection.setFixedLengthStreamingMode(body.length);
+            try(OutputStream output=connection.getOutputStream()) {output.write(body);}
+            int status=connection.getResponseCode();report.put("http_status",status);
+            InputStream stream=status>=400?connection.getErrorStream():connection.getInputStream();
+            ByteArrayOutputStream response=new ByteArrayOutputStream();
+            if(stream!=null) try(InputStream input=stream) {
+                byte[] buffer=new byte[4096];int read;
+                while((read=input.read(buffer))!=-1) {if(response.size()+read>1048576) throw new IOException();response.write(buffer,0,read);}
+            }
+            byte[] data=response.toByteArray();report.put("response_bytes",data.length);
+            // Server session bytes stay in this app's private, non-backup storage.
+            try(FileOutputStream file=context.openFileOutput("buyflow-response.pb",Context.MODE_PRIVATE)) {file.write(data);}
+            report.put("event",status==200?"initialize_response_received":"initialize_http_error");
+            String type=connection.getContentType();report.put("response_is_protobuf",type!=null && type.contains("protobuf"));
+            if(type!=null && type.contains("protobuf")) {
+                report.put("response_structure",structure(data));
+                report.put("response_nested_structure",nestedStructure(data));
+                summarizeFlow(data,report);
+            }
+            String diagnostic=new String(data,StandardCharsets.ISO_8859_1);
+            java.util.regex.Matcher code=java.util.regex.Pattern.compile("\\bOR_[A-Z0-9_]{3,36}\\b").matcher(diagnostic);
+            if(code.find())report.put("google_error_code",code.group());
+            for(String hint:new String[]{"INVALID_OAUTH_TOKEN","INVALID_SCOPE","UNAUTHORIZED","INVALID_REQUEST","DEVELOPER_ERROR"}) {
+                if(diagnostic.contains(hint))report.put("server_error_hint",hint);
+            }
+            // HTTP 200 and a valid protobuf are not payment success. Only expose
+            // field numbers, wire types and lengths; no account/card/server strings.
+        } catch(Exception failure) {
+            try {report.put("event","initialize_transport_error");report.put("error_kind",failure instanceof java.net.UnknownHostException?"dns":failure instanceof java.net.SocketTimeoutException?"timeout":failure instanceof javax.net.ssl.SSLException?"tls":"io");}catch(Exception ignored){}
+        } finally {if(connection!=null)connection.disconnect();}
+        return report.toString();
+    }
+    static String inspectCached(Context context) {
+        try(InputStream in=context.openFileInput("buyflow-response.pb")) {
+            ByteArrayOutputStream out=new ByteArrayOutputStream();byte[] b=new byte[2048];int n;
+            while((n=in.read(b))!=-1) {if(out.size()+n>1048576)throw new IOException();out.write(b,0,n);}
+            JSONObject report=new JSONObject();summarizeFlow(out.toByteArray(),report);return report.toString();
+        }catch(Exception ignored){return "{\"event\":\"cached_response_unavailable\"}";}
+    }
+    static void summarizeFlow(byte[] data,JSONObject report)throws Exception {
+        Long instruction=scalar(data,6);
+        report.put("flow_instruction",instruction==null?-1:instruction).put("has_native_page",field(data,3)!=null);
+        if(instruction!=null && instruction==5) {
+            report.put("event","initialize_ui_error").put("flow_instruction_name","HANDLE_UI_ERROR");
+            byte[] header=field(data,1);
+            if(header!=null) {
+                for(int f:new int[]{1}) {
+                    byte[] content=field(header,f);
+                    if(content!=null && content.length<=2048) {
+                        String text=StandardCharsets.UTF_8.newDecoder().decode(java.nio.ByteBuffer.wrap(content)).toString();
+                        // These are the error body/title fields, never the
+                        // opaque client session, account or payment payload.
+                        text=text.replaceAll("[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+","[account omitted]")
+                            .replaceAll("[A-Za-z0-9_+/=-]{60,}","[opaque value omitted]")
+                            .replaceAll("[0-9]{6,}","[identifier omitted]");
+                        report.put("google_error_message",text);
+                    }
+                }
+            }
+        }
+        report.put("payment_verified",false);
+    }
+    static byte[] field(byte[] data,int wanted)throws IOException {
+        int[] o={0};
+        while(o[0]<data.length) {long tag=read(data,o);int f=(int)(tag>>>3),w=(int)(tag&7);if(f==0)throw new IOException();
+            if(w==0)read(data,o);else if(w==1)o[0]+=8;else if(w==5)o[0]+=4;
+            else if(w==2) {long n=read(data,o);if(n>data.length-o[0])throw new IOException();int start=o[0];o[0]+=(int)n;if(f==wanted)return Arrays.copyOfRange(data,start,o[0]);}else throw new IOException();
+            if(o[0]>data.length)throw new IOException();
+        }return null;
+    }
+    static Long scalar(byte[] data,int wanted)throws IOException {
+        int[] o={0};
+        while(o[0]<data.length) {long tag=read(data,o);int f=(int)(tag>>>3),w=(int)(tag&7);if(f==0)throw new IOException();
+            if(w==0){long value=read(data,o);if(f==wanted)return value;}else if(w==1)o[0]+=8;else if(w==5)o[0]+=4;
+            else if(w==2){long n=read(data,o);if(n>data.length-o[0])throw new IOException();o[0]+=(int)n;}else throw new IOException();
+            if(o[0]>data.length)throw new IOException();
+        }return null;
+    }
+    private static void tokenInfo(String token,JSONObject report) {
+        HttpsURLConnection c=null;
+        try {
+            c=(HttpsURLConnection)new java.net.URL("https://oauth2.googleapis.com/tokeninfo").openConnection();
+            c.setInstanceFollowRedirects(false);c.setConnectTimeout(12000);c.setReadTimeout(12000);
+            c.setRequestMethod("POST");c.setDoOutput(true);c.setRequestProperty("Authorization","Bearer "+token);
+            c.setRequestProperty("Content-Type","application/x-www-form-urlencoded;charset=UTF-8");c.setFixedLengthStreamingMode(0);
+            c.getOutputStream().close();int status=c.getResponseCode();report.put("token_info_http_status",status);
+            if(status==200) {
+                ByteArrayOutputStream out=new ByteArrayOutputStream();
+                try(InputStream in=c.getInputStream()) {byte[] b=new byte[1024];int n;while((n=in.read(b))!=-1) {if(out.size()+n>16384)throw new IOException();out.write(b,0,n);}}
+                JSONObject info=new JSONObject(new String(out.toByteArray(),StandardCharsets.UTF_8));
+                boolean sierra=Arrays.asList(info.optString("scope").split(" ")).contains("https://www.googleapis.com/auth/sierra");
+                report.put("sierra_scope_verified",sierra).put("token_valid_at_probe",true);
+            }
+        } catch(Exception ignored) {try {report.put("token_info_check_completed",false);}catch(Exception impossible){}}
+        finally {if(c!=null)c.disconnect();}
+    }
+    static String structure(byte[] data) throws IOException {
+        StringBuilder result=new StringBuilder();int[] offset={0};int fields=0;
+        while(offset[0]<data.length) {
+            if(++fields>128) throw new IOException();
+            long tag=read(data,offset);int field=(int)(tag>>>3),wire=(int)(tag&7);
+            if(field==0)throw new IOException();
+            if(result.length()>0)result.append(',');result.append(field).append(':').append(wire);
+            if(wire==0)read(data,offset);
+            else if(wire==1)offset[0]+=8;
+            else if(wire==5)offset[0]+=4;
+            else if(wire==2) {long length=read(data,offset);if(length>1048576)throw new IOException();offset[0]+=(int)length;result.append('(').append(length).append(')');}
+            else throw new IOException();
+            if(offset[0]>data.length)throw new IOException();
+        }return result.toString();
+    }
+    static String nestedStructure(byte[] data)throws IOException {
+        StringBuilder result=new StringBuilder();int[] offset={0};int count=0;
+        while(offset[0]<data.length) {
+            if(++count>128)throw new IOException();long tag=read(data,offset);int f=(int)(tag>>>3),w=(int)(tag&7);
+            if(w==0) {long value=read(data,offset);if(f==6)result.append("status6=").append(value).append(';');}
+            else if(w==1)offset[0]+=8;else if(w==5)offset[0]+=4;
+            else if(w==2) {
+                long length=read(data,offset);if(length>1048576 || length>data.length-offset[0])throw new IOException();
+                byte[] child=Arrays.copyOfRange(data,offset[0],offset[0]+(int)length);offset[0]+=(int)length;
+                try {String shape=structure(child);if(shape.length()<2000) result.append(f).append("={").append(shape).append("};");}catch(IOException notMessage){}
+            } else throw new IOException();
+            if(offset[0]>data.length)throw new IOException();
+        } return result.toString();
+    }
+    private static long read(byte[] data,int[] offset)throws IOException {
+        long value=0;
+        for(int shift=0;shift<64;shift+=7) {if(offset[0]>=data.length)throw new IOException();int b=data[offset[0]++]&255;value|=(long)(b&127)<<shift;if((b&128)==0)return value;}
+        throw new IOException();
+    }
+    static byte[] text(int field,String value) {return bytes(field,value.getBytes(StandardCharsets.UTF_8));}
+    static byte[] bytes(int field,byte[] value) {ByteArrayOutputStream out=new ByteArrayOutputStream();varint(out,((long)field<<3)|2);varint(out,value.length);out.write(value,0,value.length);return out.toByteArray();}
+    static byte[] number(int field,long value) {ByteArrayOutputStream out=new ByteArrayOutputStream();varint(out,(long)field<<3);varint(out,value);return out.toByteArray();}
+    static byte[] message(byte[]...parts) {ByteArrayOutputStream out=new ByteArrayOutputStream();for(byte[] part:parts)out.write(part,0,part.length);return out.toByteArray();}
+    private static void varint(ByteArrayOutputStream out,long value) {while((value&~127L)!=0) {out.write((int)value&127|128);value>>>=7;}out.write((int)value);}
+}
