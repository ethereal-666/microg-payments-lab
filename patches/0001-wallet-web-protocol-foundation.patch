+/* SPDX-License-Identifier: Apache-2.0 */
+package org.microg.wallet.authprobe;
+import org.junit.Test;
+import static org.junit.Assert.*;
+@org.junit.runner.RunWith(org.robolectric.RobolectricTestRunner.class)
+@org.robolectric.annotation.Config(sdk=28,manifest=org.robolectric.annotation.Config.NONE)
+public class BuyflowSandboxProbeTest {
+    @Test public void httpSuccessBodyWithUiErrorIsNeverPaymentSuccess() throws Exception {
+        byte[] packet=BuyflowSandboxProbe.message(BuyflowSandboxProbe.bytes(1,BuyflowSandboxProbe.message(
+            BuyflowSandboxProbe.text(1,"Invalid request"),BuyflowSandboxProbe.text(3,"Error"))),BuyflowSandboxProbe.number(6,5));
+        org.json.JSONObject report=new org.json.JSONObject();BuyflowSandboxProbe.summarizeFlow(packet,report);
+        assertEquals("initialize_ui_error",report.getString("event"));
+        assertEquals("Invalid request",report.getString("google_error_message"));
+        assertFalse(report.getBoolean("payment_verified"));assertFalse(report.getBoolean("has_native_page"));
+    }
+
+    @Test public void wireEncodingMatchesProtobufGoldenValues() throws Exception {
+        assertArrayEquals(new byte[]{8,(byte)150,1},BuyflowSandboxProbe.number(1,150));
+        assertArrayEquals(new byte[]{18,3,97,98,99},BuyflowSandboxProbe.text(2,"abc"));
+        assertEquals("1:2(3),4:2(0)",BuyflowSandboxProbe.structure(new byte[]{10,3,8,1,0,34,0}));
+    }
+    @Test public void invalidLengthsNeverProduceSuccessfulStructure() {
+        for(byte[] packet:new byte[][]{ {10,5,0}, {8,(byte)128}, {0}, {15} }) {
+            try {BuyflowSandboxProbe.structure(packet);fail("Malformed protobuf accepted");}
+            catch(java.io.IOException expected){}
+        }
+    }
+    @Test public void publicTestRequestUsesBuyflowFieldsAndExactInitializer() throws Exception {
+        assertTrue(BuyflowSandboxProbe.URL.startsWith("https://wallet.google.com/"));
+        assertTrue(BuyflowSandboxProbe.URL.endsWith("/buyflowservice/initialize"));
+        String shape=BuyflowSandboxProbe.structure(BuyflowSandboxProbe.request("test","31","en-US"));
+        assertTrue(shape.startsWith("1:2("));assertTrue(shape.contains(",4:2("));assertFalse(shape.contains(",2:2("));
+    }
+}
