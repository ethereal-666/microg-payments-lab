<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.local.walletcompatprobe">
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="31" />
    <application android:label="Wallet compatibility probe" android:debuggable="true" android:testOnly="true" android:allowBackup="false">
        <activity android:name=".ProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
